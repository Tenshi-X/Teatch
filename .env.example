NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Runtime keys must belong to TWO DIFFERENT Google Cloud projects.
# FREE: a project with Gemini Free tier and no paid billing attached.
GEMINI_FREE_API_KEY=your-free-project-gemini-api-key
GEMINI_FREE_PROJECT_ID=your-free-project-id
# PAID: a project verified to use the intended active billing account.
GEMINI_PAID_API_KEY=your-paid-project-gemini-api-key
GEMINI_PAID_PROJECT_ID=your-paid-project-id
# Optional, for the operator's evaluate:sample CLI only. Never used by the web runtime.
GEMINI_API_KEY=

# Enable after migrations 001-007 and provider/model checks.
TEATCH_AI_ENABLED=false
# public: internal testing with your own account, no pilot list required.
# pilot: only listed parent profile IDs; an empty list denies everyone.
TEATCH_AI_ACCESS_MODE=public
# Default primary; fallback order: 3.8 Flash -> 3.5 Flash-Lite -> 3.6 Flash.
TEATCH_AI_MODEL=gemini-3.8-flash
# Open question types one at a time after staging acceptance.
TEATCH_ENABLED_TYPES=multiple_choice,short_answer,true_false
# Optional comma-separated parent profile UUIDs for a restricted pilot.
TEATCH_AI_PILOT_PARENT_IDS=
# Only needed when using the HTTP maintenance fallback instead of pg_cron.
TEATCH_MAINTENANCE_SECRET=
