NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
GEMINI_API_KEY=your-gemini-api-key

# Enable only after migration 005 and cost/quality evaluation pass.
TEATCH_AI_ENABLED=false
# Open question types one at a time after staging acceptance.
TEATCH_ENABLED_TYPES=multiple_choice,short_answer,true_false
# Optional comma-separated parent profile UUIDs for a restricted pilot.
TEATCH_AI_PILOT_PARENT_IDS=
